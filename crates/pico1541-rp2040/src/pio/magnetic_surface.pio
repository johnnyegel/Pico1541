.program magnetic_surface

; Operates with:
; - Autopush enabled (threshold 8)
; - Autopull enabled (threshold 8)
; - Shift direction: Left (MSB first, typical for GCR)

    set pindirs, 1      
    set pins, 1         
.wrap_target
sync_search:
    out x, 1            
    jmp !x bit_is_zero  
    
    in x, 1
    
    jmp y-- sync_search 
    
in_sync:
    mov isr, !null      
    push                
    set pins, 0         
    
sync_loop:
    set y, 7            
sync_loop_inner:
    out x, 1
    jmp !x sync_broken  
    jmp y-- sync_loop_inner
    
    mov isr, !null
    push
    jmp sync_loop
    
sync_broken:
    set pins, 1         
    mov isr, null
    push                ; Push 0x00000000 as SYNC_BROKEN token
bit_is_zero:
    set y, 8            
    in null, 1          
.wrap
