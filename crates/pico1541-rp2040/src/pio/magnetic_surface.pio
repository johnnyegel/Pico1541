.program gcr_decoder

; --- HARDWARE CONFIGURATION REQUIREMENTS ---
; 1. OSR Autopull    = false 
; 2. ISR Autopush    = true  (Threshold 8)
; 3. Shift Direction = Left  (MSB first)
; 4. SET Pin Mapping = GPIO 10 (SYNC)
; -------------------------------------------

public entry_point:
    set pindirs, 1         ; Force Output Enable high for the SYNC pin
    set pins, 0            ; SYNC starts low
    set x, 9               ; 10 consecutive 1s needed

fetch_init:
    pull block             ; Prime the OSR on boot before the loop starts
    out null, 24

read_bit:                  ; [Cycle 1] Start of the 8-cycle loop
    out y, 1               ; [Cycle 1] Pull 1 bit from OSR
    jmp !y is_zero         ; [Cycle 2] If 0, jump to is_zero path

is_one:                    ; --- THE '1' PATH ---
    in y, 1                ; [Cycle 3] Shift '1' into ISR
    jmp x-- check_osre     ; [Cycle 4] Decrement SYNC counter. If > 0, jump to gate.

    ; --- SYNC CONDITION TRIGGERED (X hit 0) ---
    set pins, 1            ; Drive SYNC high
    mov isr, null          ; Purge framing garbage
sync_wait:
    jmp !osre sync_do      ; Check if OSR has bits
    pull block             ; Fetch next word
    out null, 24           ; Strip padding
sync_do:
    out y, 1               ; Pull next bit
    jmp !y sync_broken     ; If 0, SYNC is over!
    jmp sync_wait          ; If 1, stay trapped in SYNC
sync_broken:
    set pins, 0            ; Drive SYNC low
    in y, 1                ; Shift the '0' into the fresh ISR
    set x, 9               ; Reset SYNC counter
    jmp check_osre         ; Re-enter the timing gate

is_zero:                   ; --- THE '0' PATH ---
    in y, 1                ; [Cycle 3] Shift '0' into ISR
    set x, 9               ; [Cycle 4] Reset SYNC counter

check_osre:                ; --- THE TIMING GATE ---
    jmp !osre delay_pad    ; [Cycle 5] If OSR HAS DATA (!empty), jump to padding

fetch_next:                ; --- THE FETCH PATH (OSR is empty) ---
    pull block             ; [Cycle 6] Grab next word from DMA
    out null, 24           ; [Cycle 7] Discard padding
    jmp read_bit           ; [Cycle 8] Loop back to start

delay_pad:                 ; --- THE NON-FETCH PATH (OSR has data) ---
    nop                    ; [Cycle 6] Burn a cycle to match 'pull'
    nop                    ; [Cycle 7] Burn a cycle to match 'out null'
    jmp read_bit           ; [Cycle 8] Loop back to start
