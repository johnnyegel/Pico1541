.program gcr_reader

public entry_point:
    set x, 9

fetch_byte:
    pull block
    out null, 24

read_bit:
    out y, 1
    jmp !y is_zero

is_one:
    in y, 1
    jmp x-- check_osre
    
    ; --- SYNC DETECTED ---
    mov isr, ~null
    push

sync_wait:
    jmp !osre sync_do
    pull block
    out null, 24

sync_do:
    out y, 1
    jmp y-- sync_wait
    
    ; --- SYNC BROKEN ---
    mov isr, null
    push

is_zero:
    in null, 1
    set x, 9

check_osre:
    jmp !osre read_bit
    ; OSR is empty -> 8 bits were processed -> A byte is ready!
    push
    jmp fetch_byte

